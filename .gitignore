# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env

# Engine runtime assets — provisioned from node_modules by scripts/copy-assets.mjs
/public/assets/

# Hiking tracks — downloaded same-origin by scripts/fetch-tracks.mjs
# (/public/data/* not /public/data/ — a parent-directory exclusion can't be negated by git)
/public/data/*
# peaks.geojson is the exception: the Overpass fetch is slow, so it's committed as a cache
# (see scripts/fetch-peaks.mjs). The generated tileset (peaks/) stays gitignored.
!/public/data/peaks.geojson
